# Copy this file to .env and adjust. Both values are optional: the defaults below
# are used when a variable is missing.

# PocketBase API (no trailing slash, no /_/ admin path)
VITE_PB_URL=https://jpg-services.nddu.edu.ph/pb-biosoc

# Public address of this website. It is written into every QR code, so printed tags
# stop working if it changes. Keep it stable.
VITE_SITE_URL=https://flora.nddu.edu.ph
